{
  "info": {
    "name": "Atlas Platform - Notifications",
    "_postman_id": "atlas-notifications-collection",
    "description": "Notification inbox and preferences. Run auth first.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "accessToken", "value": "" },
    { "key": "notificationId", "value": "" }
  ],
  "item": [
    {
      "name": "List Notifications",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "if (json.data && json.data.items && json.data.items.length) {",
              "  pm.collectionVariables.set('notificationId', json.data.items[0].id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": "{{baseUrl}}/api/v1/notifications?page=0&pageSize=20"
      }
    },
    {
      "name": "Unread Count",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": "{{baseUrl}}/api/v1/notifications/unread-count"
      }
    },
    {
      "name": "Mark Notification Read",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": "{{baseUrl}}/api/v1/notifications/{{notificationId}}/read"
      }
    },
    {
      "name": "Mark All Read",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": "{{baseUrl}}/api/v1/notifications/read-all"
      }
    },
    {
      "name": "Get Preferences",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": "{{baseUrl}}/api/v1/notifications/preferences"
      }
    },
    {
      "name": "Update Preferences",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"inAppEnabled\": true,\n  \"emailEnabled\": true\n}"
        },
        "url": "{{baseUrl}}/api/v1/notifications/preferences"
      }
    }
  ]
}
